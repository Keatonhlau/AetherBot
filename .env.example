# Discord bot token (required)
DISCORD_TOKEN=

# GitHub personal access token (fine-grained, read-only public repos)
GITHUB_TOKEN=

# GitHub repositories
GITHUB_REPO=wayback09/Aether
GITHUB_REGISTRY_REPO=wayback09/Aether-Extensions

# How often to poll for new releases (seconds)
POLL_INTERVAL_SECONDS=300

# How long verification tokens are valid (hours)
VERIFY_TOKEN_TTL_HOURS=24

# Comma-separated Discord user IDs of official Aether owners
# These users automatically receive both developer roles
OWNER_USER_IDS=

MODERATOR_ROLE_ID=
